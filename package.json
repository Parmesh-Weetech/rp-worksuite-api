{
  "name": "rp-worksuite-api",
  "version": "1.0.0",
  "description": "",
  "author": "RitualPlanner",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write --cache --cache-location .cache/prettier \"**/*.{js,ts,tsx,jsx,cts,mts,json,md,yml,yaml}\"",
    "format:check": "prettier --check --cache --cache-location .cache/prettier \"**/*.{js,ts,tsx,jsx,cts,mts,json,md,yml,yaml}\"",
    "start": "nest start",
    "start:local": "cross-env NODE_ENV=local nest start --watch",
    "start:dev": "cross-env NODE_ENV=dev nest start --watch",
    "start:test": "cross-env NODE_ENV=test nest start --watch",
    "start:stage": "cross-env NODE_ENV=stage nest start --watch",
    "start:debug": "cross-env NODE_ENV=dev nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=prod node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --cache --cache-location .cache/eslint/.eslintcache",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" --cache --cache-location .cache/eslint/.eslintcache",
    "lint:staged": "lint-staged",
    "test:watch": "jest --watch --config test/jest-e2e.json",
    "test:cov": "jest --coverage --config test/jest-e2e.json",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config test/jest-e2e.json",
    "test:e2e": "cross-env MODE=${npm_config_mode:-full} bash ./run-tests.sh",
    "test:e2e:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register ./node_modules/.bin/jest --runInBand --config ./test/jest-e2e.json",
    "test:unit": "jest",
    "prepare": "husky",
    "migration:run:local": "cross-env NODE_ENV=local typeorm-ts-node-commonjs migration:run -d ./db/typeorm.config.ts",
    "migration:run:dev": "cross-env NODE_ENV=dev typeorm-ts-node-commonjs migration:run -d ./db/typeorm.config.ts",
    "migration:run:test": "cross-env NODE_ENV=test typeorm-ts-node-commonjs migration:run -d ./db/typeorm.config.ts",
    "migration:run:stage": "cross-env NODE_ENV=stage typeorm-ts-node-commonjs migration:run -d ./db/typeorm.config.ts",
    "migration:run:prod": "cross-env NODE_ENV=prod typeorm-ts-node-commonjs migration:run -d ./db/typeorm.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ./db/typeorm.config.ts",
    "migration:revert:local": "cross-env NODE_ENV=local typeorm-ts-node-commonjs migration:revert -d ./db/typeorm.config.ts",
    "migration:revert:dev": "cross-env NODE_ENV=dev typeorm-ts-node-commonjs migration:revert -d ./db/typeorm.config.ts",
    "migration:revert:test": "cross-env NODE_ENV=test typeorm-ts-node-commonjs migration:revert -d ./db/typeorm.config.ts",
    "migration:revert:stage": "cross-env NODE_ENV=stage typeorm-ts-node-commonjs migration:revert -d ./db/typeorm.config.ts",
    "migration:revert:prod": "cross-env NODE_ENV=prod typeorm-ts-node-commonjs migration:revert -d ./db/typeorm.config.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d ./db/typeorm.config.ts",
    "migration:show:local": "cross-env NODE_ENV=local typeorm-ts-node-commonjs migration:show -d ./db/typeorm.config.ts",
    "migration:show:dev": "cross-env NODE_ENV=dev typeorm-ts-node-commonjs migration:show -d ./db/typeorm.config.ts",
    "migration:show:test": "cross-env NODE_ENV=test typeorm-ts-node-commonjs migration:show -d ./db/typeorm.config.ts",
    "migration:show:stage": "cross-env NODE_ENV=stage typeorm-ts-node-commonjs migration:show -d ./db/typeorm.config.ts",
    "migration:show:prod": "cross-env NODE_ENV=prod typeorm-ts-node-commonjs migration:show -d ./db/typeorm.config.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d ./db/typeorm.config.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate-test-data:local": "cross-env NODE_ENV=local GENERATE_TEST_DATA=true typeorm-ts-node-commonjs migration:run -d ./db/typeorm.config.ts",
    "migration:create:local": "cross-env NODE_ENV=local typeorm-ts-node-commonjs migration:create",
    "migration:generate:local": "cross-env NODE_ENV=local typeorm-ts-node-commonjs migration:generate -d ./db/typeorm.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.1.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix --cache --cache-location .cache/eslint/.eslintcache",
      "prettier --write --cache --cache-location .cache/prettier"
    ],
    "**/*.{js,jsx,cts,mts,json,md,yml,yaml}": [
      "prettier --write --cache --cache-location .cache/prettier"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        100
      ],
      "scope-empty": [
        2,
        "always"
      ]
    }
  }
}
